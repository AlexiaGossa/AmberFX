uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter 		= Linear;
    AddressU 	= Clamp;
    AddressV 	= Clamp;
};

uniform int iGammaType<
	string label 			= "Gamma";
	string widget_type 		= "select";
	int    option_0_value 	= 0;
	string option_0_label 	= "2.0";
	int    option_1_value 	= 1;
	string option_1_label 	= "G4C";
> = 1;


uniform int iQuantification<
	string label 			= "Quantification";
	string widget_type 		= "select";
	int    option_0_value 	= 0;
	string option_0_label 	= "Normal";
	int    option_1_value 	= 1;
	string option_1_label 	= "RGB ReQuantifier";
	int    option_2_value 	= 2;
	string option_2_label 	= "YCbCr ReQuantifier";
	int    option_3_value 	= 3;
	string option_3_label 	= "Check RGB ReQuant";
	int    option_4_value 	= 4;
	string option_4_label 	= "Check YCbCr ReQuant";
> = 0;

uniform int iQuantificationLevel<
	string label 			= "ReQuant noise threshold";
	string widget_type 		= "select";
	int    option_0_value 	= 0;
	string option_0_label 	= "Minimal";
	int    option_1_value 	= 1;
	string option_1_label 	= "Low";
	int    option_2_value 	= 2;
	string option_2_label 	= "Medium";
	int    option_3_value 	= 4;
	string option_3_label 	= "High";
	int    option_4_value 	= 12;
	string option_4_label 	= "Very high + Denoise";
	int    option_5_value 	= 36;
	string option_5_label 	= "Absurd + Denoise";

> = 0;

uniform int iDynamicRange<
	string label 			= "Dynamic Range";
	string widget_type 		= "select";
	int    option_0_value 	= 0;
	string option_0_label 	= "Normal 0-255";
	int    option_1_value 	= 1;
	string option_1_label 	= "Low 16-240";
> = 0;


uniform float fLumSat<
    string label 			= "Film lum/sat";
    string widget_type 		= "slider";
    float minimum 			= 0.0;
    float maximum 			= 1.0;
    float step 				= 0.01;
> = 0.2;

uniform float fIntensity<
    string label 			= "Skin Processing";
    string widget_type 		= "slider";
    float minimum 			= 0.0;
    float maximum 			= 1.0;
    float step 				= 0.01;
> = 0.3;

uniform int iSkinDetection<
	string label 			= "Skin Checker";
	string widget_type 		= "select";
	int    option_0_value 	= 0;
	string option_0_label 	= "Normal";
	int    option_1_value 	= 1;
	string option_1_label 	= "Show area";
	
> = 0;


uniform float fSkinTone_C_lo<
    string label 			= "SkinTone C_lo";
    string widget_type 		= "slider";
    float minimum 			= 0.00;
    float maximum 			= 0.10;
    float step 				= 0.01;
> = 0.01;

uniform float fSkinTone_C_hi<
    string label 			= "SkinTone C_hi";
    string widget_type 		= "slider";
    float minimum 			= 0.05;
    float maximum 			= 0.20;
    float step 				= 0.01;
> = 0.12;

uniform float fSkinTone_C_margin<
    string label 			= "SkinTone C_margin";
    string widget_type 		= "slider";
    float minimum 			= 0.01;
    float maximum 			= 0.10;
    float step 				= 0.01;
> = 0.05;

uniform float fSkinTone_h_lo<
    string label 			= "SkinTone h_lo";
    string widget_type 		= "slider";
    float minimum 			= 0.05;
    float maximum 			= 0.50;
    float step 				= 0.01;
> = 0.10;

uniform float fSkinTone_h_hi<
    string label 			= "SkinTone h_hi";
    string widget_type 		= "slider";
    float minimum 			= 1.00;
    float maximum 			= 1.80;
    float step 				= 0.01;
> = 1.30;

uniform float fSkinTone_h_margin<
    string label 			= "SkinTone h_margin";
    string widget_type 		= "slider";
    float minimum 			= 0.01;
    float maximum 			= 0.30;
    float step 				= 0.01;
> = 0.10;


uniform float elapsed_time;

struct vertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};



vertData mainTransform(vertData v_in)
{
	vertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv * uv_scale + uv_offset;
	return vert_out;
}



/*

	RGB <=> LMS <=> Oklab
	https://bottosson.github.io/posts/oklab/#converting-from-linear-srgb-to-oklab

*/








float3 gammaForward_2 ( float3 c )
{
	return c*c;
}


float3 clippingCompensation ( float3 c )
{	
	float 	fTemp;
	fTemp = max ( c.r, c.g );
	fTemp = max ( c.b, fTemp );
	if (fTemp>=0.999)
	{
		c = ( c + fTemp*pow(c,0.707) ) * 0.5;
	}	
	return c;
}


float3 gammaForward_G4C ( float3 c )
{
	float3 	oColorToGamma2;
	float3 	oColorToGamma4;
	float3 	oColorLo;
	float3 	oColorHi;
	float 	fTemp;
	float 	fOffsetI;
	float 	fOffsetO;
	float 	fMultiplierI;
	float 	fMultiplierO;
	float   fRatio;

	//RGB pow 2
	oColorToGamma2 = c*c;
	
	//RGB pow 4
	oColorToGamma4 = oColorToGamma2*oColorToGamma2;
	
	fOffsetI 		= 0.50;
	fMultiplierI 	= 4.00;
	
	fOffsetO 		= fOffsetI*fOffsetI;
	fTemp 			= fMultiplierI + fOffsetI;
	fTemp 			= fTemp * fTemp;
	fTemp 			= fTemp - fOffsetO;
	fMultiplierO 	= 1.0 / fTemp;
	
	//Low curve
	oColorLo = ( c * fMultiplierI ) + fOffsetI;
	oColorLo = oColorLo * oColorLo;
	oColorLo = ( oColorLo - fOffsetO ) * fMultiplierO;
	
	//High curve
	oColorHi = pow ( c, 0.2707 );
	
	//Mix between Low and High
	c = ( oColorLo * (1.0-oColorToGamma4) ) + ( oColorHi * oColorToGamma4 );
	
	return c;
}

float3 gammaBackward ( float3 c )
{
	return  pow ( c, 0.50 );
}

float3 convertRGBtoLMS ( float3 c )
{
	if (iDynamicRange==1)
	{
		c = c - float3 ( 0.0627, 0.0627, 0.0627 );
		c = c * float3 ( 1.1383, 1.1383, 1.1383 );
	}

	if (iGammaType==0)
		c = gammaForward_2 ( c );
	else
		c = gammaForward_G4C ( c );
	
    float l = dot(c, float3(0.4122214708, 0.5363325363, 0.0514459929 ) );
    float m = dot(c, float3(0.2119034982, 0.6806995451, 0.1073969566 ) );
    float s = dot(c, float3(0.0883024619, 0.2817188376, 0.6299787005 ) );
    return float3(l, m, s);
}

float cbrt ( float fValue )
{
	return pow ( fValue, 1.0 / 3.0 );
}

float3 cbrt3 ( float3 fValue )
{
	return pow ( fValue, 1.0 / 3.0 );
}

float3 convertLMStoRGB ( float3 c )
{
	float r = dot ( c, float3(+4.0767416621, -3.3077115913, +0.2309699292 ) );
	float g = dot ( c, float3(-1.2684380046, +2.6097574011, -0.3413193965 ) );
	float b = dot ( c, float3(-0.0041960863, -0.7034186147, +1.7076147010 ) );
	c.r = r;
	c.g = g;
	c.b = b;
	c = clamp(c, 0.0, 1.0);
	return gammaBackward ( c );
}

float3 convertLMStoOKLab ( float3 c )
{
	float3 lms;
	lms = cbrt3(c);
	float L = dot ( lms, float3( +0.2104542553, +0.7936177850, -0.0040720468 ) );
	float a = dot ( lms, float3( +1.9779984951, -2.4285922050, +0.4505937099 ) );
	float b = dot ( lms, float3( +0.0259040371, +0.7827717662, -0.8086757660 ) );
	return float3(L, a, b);
}

float3 convertOKLabtoLMS ( float3 c )
{
	float3 lms;
	
	float l = dot ( c, float3( 1.0, +0.3963377774, +0.2158037573 ) );
	float m = dot ( c, float3( 1.0, -0.1055613458, -0.0638541728 ) );
	float s = dot ( c, float3( 1.0, -0.0894841775, -1.2914855480 ) );
	lms.r = l;
	lms.g = m;
	lms.b = s;
	return lms*lms*lms;
}

float3 convertOKLabtoOKLCh ( float3 c )
{
	float C = sqrt ( (c.g * c.g) + (c.b * c.b) );
	float h = atan2 ( c.b, c.g );
	return float3 ( c.r, C, h );
}

float3 convertOKLChtoOKLab ( float3 c )
{
	float a = c.g * cos ( c.b );
	float b = c.g * sin ( c.b );
	return float3 ( c.r, a, b );
}



float3 RGB_to_YCbCr(float3 c)
{
    float r =       dot(c, float3(  0.299000,  0.587000,  0.114000 ));
    float g = 0.5 + dot(c, float3( -0.168736, -0.331264,  0.500000 ));
    float b = 0.5 + dot(c, float3(  0.500000, -0.418688, -0.081312 ));
    return float3(r, g, b);
}

float3 YCbCr_to_RGB(float3 c)
{
	float3 fTemp3 = c + float3(0,-0.5,-0.5);
    float r = dot(fTemp3, float3( 1.0,  0.000000,  1.402000 ));
    float g = dot(fTemp3, float3( 1.0, -0.344136, -0.714136 ));
    float b = dot(fTemp3, float3( 1.0,  1.772000,  0.000000 ));
	return float3(r, g, b);
}

float3 mainImageGetPixel ( float2 uv )
{


	if (iQuantification>=3)
	{
		float3 oPixel = rgb_to_yuv(image.Sample(textureSampler, uv).rgb);
		oPixel = oPixel * 16;
		oPixel = floor ( oPixel + 0.5 );
		return oPixel * (1.0/16.0);
	}
	else
	{
		return rgb_to_yuv(image.Sample(textureSampler, uv).rgb);
		//return image.Sample(textureSampler, uv).rgb;
	}
	
}

float3 mainImageGetPixelRGB ( float2 uv )
{
	return image.Sample(textureSampler, uv).rgb;
	/*

	float3 oPixel;
	
	oPixel = image.Sample(textureSampler, uv).rgb;;
	oPixel = oPixel * 16;
	oPixel = floor ( oPixel + 0.5 );
	return oPixel * (1.0/256.0);
	//return image.Sample(textureSampler, uv).rgb;
	*/	
}

float3 mainImageGetPixelYCbCr ( float2 uv )
{
	return RGB_to_YCbCr ( image.Sample(textureSampler, uv).rgb );
}

float3 mainImageGetBlurBox5x5 ( float2 uv )
{
	float2 px = float2(2.0,2.0) / uv_size; //float2 ( 1.0, 1.0 );
	float3 c = float3 ( 0.0, 0.0, 0.0 );
	
	c += mainImageGetPixelRGB ( uv + px * float2 ( -2.0, -2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 ( -1.0, -2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  0.0, -2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  1.0, -2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  2.0, -2.0 ) );

	c += mainImageGetPixelRGB ( uv + px * float2 ( -2.0, -1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 ( -1.0, -1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  0.0, -1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  1.0, -1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  2.0, -1.0 ) );

	c += mainImageGetPixelRGB ( uv + px * float2 ( -2.0,  0.0 ) );	
	c += mainImageGetPixelRGB ( uv + px * float2 ( -1.0,  0.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  0.0,  0.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  1.0,  0.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  2.0,  0.0 ) );

	c += mainImageGetPixelRGB ( uv + px * float2 ( -2.0,  1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 ( -1.0,  1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  0.0,  1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  1.0,  1.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  2.0,  1.0 ) );
	
	c += mainImageGetPixelRGB ( uv + px * float2 ( -2.0,  2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 ( -1.0,  2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  0.0,  2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  1.0,  2.0 ) );
	c += mainImageGetPixelRGB ( uv + px * float2 (  2.0,  2.0 ) );
	
	return c * (1.0 / 25.0);

}

/*
	Super quantification
*/
float3 mainImageGetSuperQuantificationGetDeltaValue ( float3 oPixel0, float3 oPixel1 )
{
	float3 oDelta = abs ( oPixel0 - oPixel1 ) * 255;
	return oDelta;
}

float3 mainImageGetSuperQuantificationGetDeltaSum ( float3 oDelta0, float3 oDelta1, float3 oDelta2, float3 oDelta3 )
{
	float3 oDeltaSum = oDelta0 + oDelta1 + oDelta2 + oDelta3;
	return oDeltaSum;
}

float3 mainImageGetSuperQuantificationGetDeltaMax ( float3 oDelta0, float3 oDelta1, float3 oDelta2, float3 oDelta3 )
{
	float3 oDeltaMax = max ( max ( oDelta0, oDelta1 ), max ( oDelta2, oDelta3 ) );
	return oDeltaMax;
}

float3 mainImageGetSuperQuantificationGetNewPixel ( float3 oPixel0, float3 oPixel1, float3 oPixel2, float3 oPixel3, float3 oPixel4, float3 oDeltaSum, float3 oDeltaMax )
{
	float3 newPixel;
	float3 oDeltaPixel;
	float  fMaxLevel1;
	float  fMaxLevel2;
	float  fSumLevel1;
	float  fSumLevel2;
	float  fSumLevel3;	
	
	fMaxLevel1 = iQuantificationLevel + 1.0;
	fMaxLevel2 = fMaxLevel1 * 2.0;
	fSumLevel1 = iQuantificationLevel + 1.0;
	fSumLevel2 = fSumLevel1 * 2.0;
	fSumLevel3 = fSumLevel1 * 3.0;
	

	if ((oDeltaMax.r<=fMaxLevel1)&&(oDeltaSum.r<=fSumLevel1))
		newPixel.r = ( oPixel0.r +     oPixel1.r +   oPixel2.r +     oPixel3.r + oPixel4.r ) * 0.2;
	else if ((oDeltaMax.r<=fMaxLevel1)&&(oDeltaSum.r<=fSumLevel2))
		newPixel.r = ( oPixel0.r +     oPixel1.r + 2*oPixel2.r +     oPixel3.r + oPixel4.r ) / 6;
	else if ((oDeltaMax.r<=fMaxLevel1)&&(oDeltaSum.r<=fSumLevel3))
		newPixel.r = ( oPixel0.r + 1.5*oPixel1.r + 2*oPixel2.r + 1.5*oPixel3.r + oPixel4.r ) / 7;
	else if ((oDeltaMax.r<=fMaxLevel2)&&(oDeltaSum.r<=fSumLevel2))
		newPixel.r = ( oPixel0.r + 1.5*oPixel1.r + 2*oPixel2.r + 1.5*oPixel3.r + oPixel4.r ) / 7;
	else if ((oDeltaMax.r<=fMaxLevel2)&&(oDeltaSum.r<=fSumLevel3))
		newPixel.r = ( oPixel0.r +   3*oPixel1.r + 8*oPixel2.r +   3*oPixel3.r + oPixel4.r ) * 0.0625;
	else
		newPixel.r = oPixel2.r;
		
	if ((oDeltaMax.g<=fMaxLevel1)&&(oDeltaSum.g<=fSumLevel1))
		newPixel.g = ( oPixel0.g +     oPixel1.g +   oPixel2.g +     oPixel3.g + oPixel4.g ) * 0.2;
	else if ((oDeltaMax.g<=fMaxLevel1)&&(oDeltaSum.g<=fSumLevel2))
		newPixel.g = ( oPixel0.g +     oPixel1.g + 2*oPixel2.g +     oPixel3.g + oPixel4.g ) / 6;
	else if ((oDeltaMax.g<=fMaxLevel1)&&(oDeltaSum.g<=fSumLevel3))
		newPixel.g = ( oPixel0.g + 1.5*oPixel1.g + 2*oPixel2.g + 1.5*oPixel3.g + oPixel4.g ) / 7;
	else if ((oDeltaMax.g<=fMaxLevel2)&&(oDeltaSum.g<=fSumLevel2))
		newPixel.g = ( oPixel0.g + 1.5*oPixel1.g + 2*oPixel2.g + 1.5*oPixel3.g + oPixel4.g ) / 7;
	else if ((oDeltaMax.g<=fMaxLevel2)&&(oDeltaSum.g<=fSumLevel3))
		newPixel.g = ( oPixel0.g +   3*oPixel1.g + 8*oPixel2.g +   3*oPixel3.g + oPixel4.g ) * 0.0625;
	else
		newPixel.g = oPixel2.g;

	if ((oDeltaMax.b<=fMaxLevel1)&&(oDeltaSum.b<=fSumLevel1))
		newPixel.b = ( oPixel0.b +     oPixel1.b +   oPixel2.b +     oPixel3.b + oPixel4.b ) * 0.2;
	else if ((oDeltaMax.b<=fMaxLevel1)&&(oDeltaSum.b<=fSumLevel2))
		newPixel.b = ( oPixel0.b +     oPixel1.b + 2*oPixel2.b +     oPixel3.b + oPixel4.b ) / 6;
	else if ((oDeltaMax.b<=fMaxLevel1)&&(oDeltaSum.b<=fSumLevel3))
		newPixel.b = ( oPixel0.b + 1.5*oPixel1.b + 2*oPixel2.b + 1.5*oPixel3.b + oPixel4.b ) / 7;
	else if ((oDeltaMax.b<=fMaxLevel2)&&(oDeltaSum.b<=fSumLevel2))
		newPixel.b = ( oPixel0.b + 1.5*oPixel1.b + 2*oPixel2.b + 1.5*oPixel3.b + oPixel4.b ) / 7;
	else if ((oDeltaMax.b<=fMaxLevel2)&&(oDeltaSum.b<=fSumLevel3))
		newPixel.b = ( oPixel0.b +   3*oPixel1.b + 8*oPixel2.b +   3*oPixel3.b + oPixel4.b ) * 0.0625;
	else
		newPixel.b = oPixel2.b;
		
		
	oDeltaPixel = abs ( newPixel - oPixel2 ) * 255;
	
	if (oDeltaPixel.r>0.75)
		newPixel.r = ( newPixel.r + oPixel2.r ) * 0.5;
	if (oDeltaPixel.g>0.75)
		newPixel.g = ( newPixel.g + oPixel2.g ) * 0.5;
	if (oDeltaPixel.b>0.75)
		newPixel.b = ( newPixel.b + oPixel2.b ) * 0.5;

		
	return newPixel;
}


float3 mainImageGetSuperQuantificationGetCompensation ( float3 oDeltaSum, float3 oDeltaMax )
{
	float3 oDeltaPixel;
	
	float3 ratioCompensation = float3 ( 1.0, 1.0, 1.0 );
	float3 ratioPower = float3 ( 0.707, 0.707, 0.707 );
	float3 valueRatio;
		
	if ( (oDeltaSum.r>0) && (oDeltaMax.r>0) )
	{
		valueRatio.r = (oDeltaMax.r*4)+oDeltaSum.r;
		if (valueRatio.r<=11)
		{
			ratioCompensation.r = pow ( 1/(valueRatio.r-4), ratioPower.r );
		}
	}
	if ( (oDeltaSum.g>0) && (oDeltaMax.g>0) )
	{
		valueRatio.g = (oDeltaMax.g*4)+oDeltaSum.g;
		if (valueRatio.g<=11)
		{
			ratioCompensation.g = pow ( 1/(valueRatio.g-4), ratioPower.g );
		}
	}
	if ( (oDeltaSum.b>0) && (oDeltaMax.b>0) )
	{
		valueRatio.b = (oDeltaMax.b*4)+oDeltaSum.b;
		if (valueRatio.b<=11)
		{
			ratioCompensation.b = pow ( 1/(valueRatio.b-4), ratioPower.b );
		}
	}
 
	return ratioCompensation;
}

float3 mainImageGetSuperQuantificationRGB ( float2 uv )
{
	float2 px = float2 ( 2.0, 2.0 ) / uv_size;
	float3 oPixel0, oPixel1, oPixel2, oPixel3, oPixel4;
	float3 oDelta0, oDelta1, oDelta2, oDelta3;
	float3 oDeltaSum;
	float3 oDeltaMax;
	
	float3 oPixelH;
	float3 oPixelV;
	float3 oPixelD1;
	float3 oPixelD2;

	float3 oCompensationH;
	float3 oCompensationV;
	float3 oCompensationD1;
	float3 oCompensationD2;
	
	float3 oRatioTotal;
	
	
	// Central pixel
	oPixel2 = mainImageGetPixelRGB ( uv + px * float2 (  0.0,  0.0 ) );
	
	//
	//	Horizontal processing
	//
	oPixel0 = mainImageGetPixelRGB ( uv + px * float2 ( -2.0,  0.0 ) );
	oPixel1 = mainImageGetPixelRGB ( uv + px * float2 ( -1.0,  0.0 ) );	
	oPixel3 = mainImageGetPixelRGB ( uv + px * float2 (  1.0,  0.0 ) );
	oPixel4 = mainImageGetPixelRGB ( uv + px * float2 (  2.0,  0.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelH = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationH = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//
	//	Vertical processing
	//
	oPixel0 = mainImageGetPixelRGB ( uv + px * float2 (  0.0, -2.0 ) );
	oPixel1 = mainImageGetPixelRGB ( uv + px * float2 (  0.0, -1.0 ) );
	oPixel3 = mainImageGetPixelRGB ( uv + px * float2 (  0.0,  1.0 ) );
	oPixel4 = mainImageGetPixelRGB ( uv + px * float2 (  0.0,  2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelV = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationV = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//
	//	Diagonal #1 processing
	//
	oPixel0 = mainImageGetPixelRGB ( uv + px * float2 ( -2.0, -2.0 ) );
	oPixel1 = mainImageGetPixelRGB ( uv + px * float2 ( -1.0, -1.0 ) );
	oPixel3 = mainImageGetPixelRGB ( uv + px * float2 (  1.0,  1.0 ) );
	oPixel4 = mainImageGetPixelRGB ( uv + px * float2 (  2.0,  2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelD1 = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationD1 = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );

	//
	//	Diagonal #2 processing
	//
	oPixel0 = mainImageGetPixelRGB ( uv + px * float2 ( -2.0,  2.0 ) );
	oPixel1 = mainImageGetPixelRGB ( uv + px * float2 ( -1.0,  1.0 ) );
	oPixel3 = mainImageGetPixelRGB ( uv + px * float2 (  1.0, -1.0 ) );
	oPixel4 = mainImageGetPixelRGB ( uv + px * float2 (  2.0, -2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelD2 = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationD2 = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//oRatioTotal = 1 / (oCompensationH + oCompensationV + oCompensationD1 + oCompensationD2);
	//return ( oPixelH * oCompensationH + oPixelV * oCompensationV + oPixelD1 * oCompensationD1 + oPixelD2 * oCompensationD2 ) * oRatioTotal;
	
	return ( oPixelH + oPixelV+ oPixelD1 + oPixelD2 ) * 0.25;
}

float3 mainImageGetSuperQuantificationYCbCr ( float2 uv )
{
	float2 px = float2 ( 2.0, 2.0 ) / uv_size;
	float3 oPixel0, oPixel1, oPixel2, oPixel3, oPixel4;
	float3 oDelta0, oDelta1, oDelta2, oDelta3;
	float3 oDeltaSum;
	float3 oDeltaMax;
	
	float3 oPixelH;
	float3 oPixelV;
	float3 oPixelD1;
	float3 oPixelD2;

	float3 oCompensationH;
	float3 oCompensationV;
	float3 oCompensationD1;
	float3 oCompensationD2;
	
	float3 oRatioTotal;
	
	
	// Central pixel
	oPixel2 = mainImageGetPixelYCbCr ( uv + px * float2 (  0.0,  0.0 ) );
	
	//
	//	Horizontal processing
	//
	oPixel0 = mainImageGetPixelYCbCr ( uv + px * float2 ( -2.0,  0.0 ) );
	oPixel1 = mainImageGetPixelYCbCr ( uv + px * float2 ( -1.0,  0.0 ) );	
	oPixel3 = mainImageGetPixelYCbCr ( uv + px * float2 (  1.0,  0.0 ) );
	oPixel4 = mainImageGetPixelYCbCr ( uv + px * float2 (  2.0,  0.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelH = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationH = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//
	//	Vertical processing
	//
	oPixel0 = mainImageGetPixelYCbCr ( uv + px * float2 (  0.0, -2.0 ) );
	oPixel1 = mainImageGetPixelYCbCr ( uv + px * float2 (  0.0, -1.0 ) );
	oPixel3 = mainImageGetPixelYCbCr ( uv + px * float2 (  0.0,  1.0 ) );
	oPixel4 = mainImageGetPixelYCbCr ( uv + px * float2 (  0.0,  2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelV = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationV = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//
	//	Diagonal #1 processing
	//
	oPixel0 = mainImageGetPixelYCbCr ( uv + px * float2 ( -2.0, -2.0 ) );
	oPixel1 = mainImageGetPixelYCbCr ( uv + px * float2 ( -1.0, -1.0 ) );
	oPixel3 = mainImageGetPixelYCbCr ( uv + px * float2 (  1.0,  1.0 ) );
	oPixel4 = mainImageGetPixelYCbCr ( uv + px * float2 (  2.0,  2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelD1 = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationD1 = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );

	//
	//	Diagonal #2 processing
	//
	oPixel0 = mainImageGetPixelYCbCr ( uv + px * float2 ( -2.0,  2.0 ) );
	oPixel1 = mainImageGetPixelYCbCr ( uv + px * float2 ( -1.0,  1.0 ) );
	oPixel3 = mainImageGetPixelYCbCr ( uv + px * float2 (  1.0, -1.0 ) );
	oPixel4 = mainImageGetPixelYCbCr ( uv + px * float2 (  2.0, -2.0 ) );
	oDelta0 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel0, oPixel1 );
	oDelta1 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel1, oPixel2 );
	oDelta2 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel2, oPixel3 );
	oDelta3 = mainImageGetSuperQuantificationGetDeltaValue ( oPixel3, oPixel4 );
	oDeltaSum = mainImageGetSuperQuantificationGetDeltaSum ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oDeltaMax = mainImageGetSuperQuantificationGetDeltaMax ( oDelta0, oDelta1, oDelta2, oDelta3 );
	oPixelD2 = mainImageGetSuperQuantificationGetNewPixel ( oPixel0, oPixel1, oPixel2, oPixel3, oPixel4, oDeltaSum, oDeltaMax );
	//oCompensationD2 = mainImageGetSuperQuantificationGetCompensation ( oDeltaSum, oDeltaMax );
	
	//oRatioTotal = 1 / (oCompensationH + oCompensationV + oCompensationD1 + oCompensationD2);
	//return ( oPixelH * oCompensationH + oPixelV * oCompensationV + oPixelD1 * oCompensationD1 + oPixelD2 * oCompensationD2 ) * oRatioTotal;
	
	return ( oPixelH + oPixelV+ oPixelD1 + oPixelD2 ) * 0.25;
}




float3 mainImageGetSuperQuantificationLowRes ( float2 uv )
{

}

float4 mainImage(vertData v_in) : TARGET
{
	float4 			oPixel4;
	float3			oPixel3;
	float3			oPixelBlur3;
	
	//Get 1 pixel
	oPixel4 = image.Sample(textureSampler, v_in.uv );
	oPixel3	= oPixel4.rgb;
	
	//
	//	Quantification processing
	//
	if (iQuantification==1)
	{
		oPixel3			=	mainImageGetSuperQuantificationRGB ( v_in.uv );
	}
	else if (iQuantification==2)
	{
		oPixel3			=	YCbCr_to_RGB(mainImageGetSuperQuantificationYCbCr ( v_in.uv ));
	}
	else if (iQuantification==3)
	{
		float3 oNewPixel3;
		oNewPixel3		=	mainImageGetSuperQuantificationRGB ( v_in.uv );
		oPixel4.rgb		=	abs(oPixel3-oNewPixel3) * 256;
		oPixel4.a 		= 	1.0;
		return saturate(oPixel4);	
	}
	else if (iQuantification==4)
	{
		float3 oNewPixel3;
		oNewPixel3		=	YCbCr_to_RGB(mainImageGetSuperQuantificationYCbCr ( v_in.uv ));
		oPixel4.rgb		=	abs(oPixel3-oNewPixel3) * 256;
		oPixel4.a 		= 	1.0;
		return saturate(oPixel4);	
	}
	
	
	/*	
	if (iQuantification==2)
	{
		float3 oPixel3Quantification	= mainImageGetSuperQuantification ( v_in.uv );
		if ( (oPixel3Quantification.r!=oPixel3.r) ||
			 (oPixel3Quantification.g!=oPixel3.g) ||
			 (oPixel3Quantification.b!=oPixel3.b) )
			oPixel3 = float3 ( 1.0, 1.0, 1.0 );
	}
	else if (iQuantification==1)
	{
		oPixel3			=	yuv_to_rgb(mainImageGetSuperQuantification ( v_in.uv ));
	}
	else if (iQuantification==3)
	{
		float3 oNewPixel3;
		oNewPixel3		=	mainImageGetPixel ( v_in.uv );
		oNewPixel3 		= 	yuv_to_rgb(oNewPixel3);
		
		
		oPixel4.rgb		=	abs(oPixel3-oNewPixel3) * 8;
		oPixel4.a 		= 	1.0;
		return saturate(oPixel4);	
	}
	else if (iQuantification==4)
	{
		float3 oNewPixel3;
		//oPixel3			=	mainImageGetPixel ( v_in.uv );
		oNewPixel3		=	mainImageGetSuperQuantification ( v_in.uv );
		//oPixel3 		= 	yuv_to_rgb(oPixel3);
		oNewPixel3 		= 	yuv_to_rgb(oNewPixel3);
		
		oPixel4.rgb		=	abs (oPixel3-oNewPixel3) * 8;
		oPixel4.a 		= 	1.0;
		return saturate(oPixel4);	
	}
	*/
	

	//
	//	Clipping compensation
	//
	oPixel3			=   clippingCompensation ( oPixel3 );
	
	//Get 1 blured pixel
	oPixelBlur3		=	mainImageGetBlurBox5x5 ( v_in.uv );
	
	//Convert RGB to OKLCh
	oPixel3			= 	convertRGBtoLMS ( oPixel3 );
	oPixel3			=   convertLMStoOKLab ( oPixel3 );
	oPixel3			=   convertOKLabtoOKLCh ( oPixel3 );
	
	oPixelBlur3		= 	convertRGBtoLMS ( oPixelBlur3 );
	oPixelBlur3		=   convertLMStoOKLab ( oPixelBlur3 );
	oPixelBlur3		=   convertOKLabtoOKLCh ( oPixelBlur3 );

	float fPixel_L 	= 	oPixel3.r;
	float fPixel_C 	= 	oPixel3.g;
	float fPixel_h 	= 	oPixel3.b;

	float fPixelBlur_L 	= 	oPixelBlur3.r;
	float fPixelBlur_C 	= 	oPixelBlur3.g;
	float fPixelBlur_h 	= 	oPixelBlur3.b;
	
	//sk is desaturation ratio (0.0 = min, 1.0 = max)
	float sk		=   fIntensity;	
	
	float fTemp;
	
	fTemp			= 	1.0 - (fPixelBlur_L*sk);
	
	
	
	//
	//	Skintone detection
	//
	float fSkinTone_C_lo2;
	float fSkinTone_C_hi2;
	float fSkinTone_C_mlo;
	float fSkinTone_C_mhi;
	
	float fSkinTone_h_lo2;
	float fSkinTone_h_hi2;
	float fSkinTone_h_mlo;
	float fSkinTone_h_mhi;
	
	float fAlpha_C;
	float fAlpha_h;
	float fSkinAlpha;
	
	fSkinTone_C_lo2 = fSkinTone_C_lo - fSkinTone_C_margin;
	fSkinTone_C_hi2 = fSkinTone_C_hi + fSkinTone_C_margin;
	fSkinTone_C_lo2 = clamp ( fSkinTone_C_lo2, 0.0, 1.0 );
	
	fSkinTone_C_mlo = 1.0 / ( fSkinTone_C_lo - fSkinTone_C_lo2 );
	fSkinTone_C_mhi = 1.0 / ( fSkinTone_C_hi2 - fSkinTone_C_hi );
	
	fSkinTone_h_lo2 = fSkinTone_h_lo - fSkinTone_h_margin;
	fSkinTone_h_hi2 = fSkinTone_h_hi + fSkinTone_h_margin;
	fSkinTone_h_mlo = 1.0 / ( fSkinTone_h_lo - fSkinTone_h_lo2 );
	fSkinTone_h_mhi = 1.0 / ( fSkinTone_h_hi2 - fSkinTone_h_hi );
	



	
	if ((fPixelBlur_C>=fSkinTone_C_lo) && (fPixelBlur_C<=fSkinTone_C_hi))
	{
		fAlpha_C = 1.0;
	}
	else if ( (fPixelBlur_C>fSkinTone_C_lo2) && (fPixelBlur_C<fSkinTone_C_lo) )
	{
		fAlpha_C = (fPixelBlur_C - fSkinTone_C_lo2) * fSkinTone_C_mlo;
	}
	else if ( (fPixelBlur_C>fSkinTone_C_hi) && (fPixelBlur_C<fSkinTone_C_hi2) )
	{
		fAlpha_C = 1.0 - ( (fPixelBlur_C - fSkinTone_C_hi) * fSkinTone_C_mhi );
	}
	else
	{
		fAlpha_C = 0.0;
	}

	if ((fPixelBlur_h>=fSkinTone_h_lo) && (fPixelBlur_h<=fSkinTone_h_hi))
	{
		fAlpha_h = 1.0;
	}
	else if ( (fPixelBlur_h>fSkinTone_h_lo2) && (fPixelBlur_h<fSkinTone_h_lo) )
	{
		fAlpha_h = (fPixelBlur_h - fSkinTone_h_lo2) * fSkinTone_h_mlo;
	}
	else if ( (fPixelBlur_h>fSkinTone_h_hi) && (fPixelBlur_h<fSkinTone_h_hi2) )
	{
		fAlpha_h = 1.0 - ( (fPixelBlur_h - fSkinTone_h_hi) * fSkinTone_h_mhi );
	}
	else
	{
		fAlpha_h = 0.0;
	}
	
	//fSkinAlpha = fAlpha_h * 1.50 * fAlpha_C;
	//fSkinAlpha = (fSkinAlpha * fSkinAlpha) * 0.5;
	
	
	
	fSkinAlpha = fAlpha_C*fAlpha_h;
	
	
	fSkinAlpha = clamp ( fSkinAlpha, 0.0, 1.0 );
	
	
	
	
	if (iSkinDetection==1)
	{
		fPixel_L		=   fSkinAlpha;
		fPixel_C 		=   0.0;
		fPixel_h		=	0.0;
	}
	else
	{
		float fSkinA_L = 0.96;
		float fSkinA_C = 0.02;
		float fSkinA_h = 1.60;
		
		fSkinA_L = 0.735;
		fSkinA_C = 0.055;
		fSkinA_h = 0.92;
		

		float fSkinB_L = 0.95;
		float fSkinB_C = 0.03;
		float fSkinB_h = 1.50;
		
		float fSkinMin_C;
		
		fSkinMin_C = (fPixel_C + fSkinA_C + fSkinB_C) * 0.2;
		
		//fSkinAlpha *= 0.1;
		
		//fPixel_L = lerp ( fPixel_L, fSkin_L, fSkinAlpha );
		fPixel_C = lerp ( fPixel_C, fSkinMin_C, fSkinAlpha * fIntensity );
		//fPixel_h = lerp ( fPixel_h, fSkinA_h, fSkinAlpha * 0.3 );
		
		fPixel_h = lerp ( fPixel_h, 0.82, fSkinAlpha * fIntensity * 0.2 );
	
	
		//
		//	Chemical film processing
		//
		fTemp = pow ( fPixelBlur_L, 6 );
		fPixel_C = lerp ( fPixel_C, fPixel_C*(1.0-fLumSat), fTemp );
	}
	
	oPixel3.r		= 	fPixel_L;
	oPixel3.g		= 	fPixel_C;
	oPixel3.b		= 	fPixel_h;
	
	oPixel3			=   convertOKLChtoOKLab ( oPixel3 );
	oPixel3			=   convertOKLabtoLMS ( oPixel3 );
	oPixel3			=	convertLMStoRGB ( oPixel3 );
	
	oPixel4.rgb		=	oPixel3;
	oPixel4.a 		= 	1.0;
	
    return saturate(oPixel4);
}


technique Draw
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader  = mainImage(v_in);
	}
}
